# 从 PE 导入表递归收集运行库，避免复制整个 Qt SDK 或 MSVC CRT 目录。
function(zzapk_deploy_runtime_dependencies stage qtBinDirectory crtDirectory dumpbin systemDirectory)
    file(GLOB_RECURSE pending "${stage}/*.exe" "${stage}/*.dll")
    set(visited)
    while(pending)
        list(POP_FRONT pending binary)
        get_filename_component(binaryName "${binary}" NAME)
        string(TOLOWER "${binaryName}" binaryKey)
        if(binaryKey IN_LIST visited)
            continue()
        endif()
        list(APPEND visited "${binaryKey}")
        execute_process(COMMAND "${dumpbin}" /nologo /dependents "${binary}"
            OUTPUT_VARIABLE imports ERROR_VARIABLE scanError RESULT_VARIABLE scanResult)
        if(NOT scanResult EQUAL 0)
            message(FATAL_ERROR "Cannot inspect ${binary}: ${scanError}")
        endif()
        string(REPLACE "\r" "" imports "${imports}")
        string(REPLACE "\n" ";" lines "${imports}")
        foreach(line IN LISTS lines)
            if(NOT line MATCHES "^[ \t]+([A-Za-z0-9_.+-]+\\.[dD][lL][lL])[ \t]*$")
                continue()
            endif()
            set(name "${CMAKE_MATCH_1}")
            string(TOLOWER "${name}" key)
            if(key IN_LIST visited OR key MATCHES "^(api-ms-|ext-ms-)")
                continue()
            endif()
            if(EXISTS "${stage}/${name}")
                list(APPEND pending "${stage}/${name}")
                continue()
            endif()
            # CRT 必须来自可再分发目录，不能借用构建机 System32 中已安装的版本。
            if(EXISTS "${crtDirectory}/${name}")
                set(source "${crtDirectory}/${name}")
            elseif(key MATCHES "^(msvcp|vcruntime|concrt|vcomp)[0-9]")
                message(FATAL_ERROR "Required MSVC runtime is missing from ${crtDirectory}: ${name}")
            elseif(EXISTS "${systemDirectory}/${name}")
                continue()
            elseif(EXISTS "${qtBinDirectory}/${name}")
                set(source "${qtBinDirectory}/${name}")
            else()
                message(FATAL_ERROR "Cannot resolve ${name}, imported by ${binaryName}")
            endif()
            file(COPY "${source}" DESTINATION "${stage}")
            list(APPEND pending "${stage}/${name}")
        endforeach()
    endwhile()
endfunction()
