cmake_minimum_required(VERSION 3.25)

# cmake -P 不继承主项目策略，需要在独立入口声明版本。
# CPack 安装阶段调用此脚本，暂存目录固定在构建树内部。
if(NOT CONFIG STREQUAL "Release" OR
   (NOT "@CMAKE_BUILD_TYPE@" STREQUAL "" AND NOT "@CMAKE_BUILD_TYPE@" STREQUAL "Release"))
    message(FATAL_ERROR "package-windows requires a Release build")
endif()
set(stage "@CMAKE_BINARY_DIR@/dist")
if(NOT EXISTS "${APP}")
    message(FATAL_ERROR "Build ZzApkInfo before deploying")
endif()
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/licenses/ZzPureTools")
file(COPY "${APP}" "@PROJECT_SOURCE_DIR@/tools/aapt.exe"
    "@PROJECT_SOURCE_DIR@/tools/aapt2.exe" "@PROJECT_SOURCE_DIR@/README.md"
    DESTINATION "${stage}")
file(COPY "@PROJECT_SOURCE_DIR@/licenses/" DESTINATION "${stage}/licenses")
file(COPY "@PROJECT_SOURCE_DIR@/tools/NOTICE.txt" DESTINATION "${stage}/licenses/Android")
file(COPY "@ZZAPK_ZZPURETOOLS_SOURCE_DIR@/LICENSE"
    "@ZZAPK_ZZPURETOOLS_SOURCE_DIR@/docs/third-party/THIRD_PARTY_NOTICES.md"
    DESTINATION "${stage}/licenses/ZzPureTools")
file(COPY "@ZZAPK_ZZPURETOOLS_SOURCE_DIR@/ZzThirdParty/ZzLog/LICENSE"
    DESTINATION "${stage}/licenses/ZzLog")
file(COPY "@ZZAPK_ZZPURETOOLS_SOURCE_DIR@/ZzThirdParty/ZzLog/licenses/"
    DESTINATION "${stage}/licenses/ZzLog")
file(COPY "@ZZAPK_ZZPURETOOLS_SOURCE_DIR@/ZzThirdParty/qwindowkit/LICENSE"
    "@ZZAPK_ZZPURETOOLS_SOURCE_DIR@/ZzThirdParty/qwindowkit/docs/framelesshelper-related.md"
    DESTINATION "${stage}/licenses/QWindowKit")
# Fluent 样式直接使用 QtSvg 渲染 SVG；运行时仅需要窗口平台和 ICO 解码插件。
foreach(plugin IN ITEMS platforms/qwindows.dll imageformats/qico.dll)
    if(NOT EXISTS "@ZZAPK_QT_PLUGINS_DIR@/${plugin}")
        message(FATAL_ERROR "Required Qt plugin is missing: ${plugin}")
    endif()
    get_filename_component(pluginDirectory "${plugin}" DIRECTORY)
    file(COPY "@ZZAPK_QT_PLUGINS_DIR@/${plugin}" DESTINATION "${stage}/${pluginDirectory}")
endforeach()
# 明确限定到包内插件，防止运行时回退到 Qt SDK 的绝对安装路径。
file(WRITE "${stage}/qt.conf" "[Paths]\nPrefix=.\nPlugins=.\n")
file(TO_CMAKE_PATH "$ENV{VCToolsRedistDir}" redistRoot)
if(NOT redistRoot)
    message(FATAL_ERROR "VCToolsRedistDir is absent; run from an x64 MSVC developer shell")
endif()
file(GLOB crtDirectories LIST_DIRECTORIES TRUE "${redistRoot}/x64/Microsoft.VC*.CRT")
list(SORT crtDirectories COMPARE NATURAL ORDER DESCENDING)
if(NOT crtDirectories)
    message(FATAL_ERROR "MSVC x64 CRT redistribution directory is absent: ${redistRoot}")
endif()
list(GET crtDirectories 0 crtDirectory)
include("@PROJECT_SOURCE_DIR@/cmake/DeployRuntimeDependencies.cmake")
zzapk_deploy_runtime_dependencies("${stage}" "@qtBinDirectory@" "${crtDirectory}"
    "@ZZAPK_DUMPBIN@" "$ENV{SystemRoot}/System32")
file(WRITE "${stage}/build-info.txt"
    "ZzApkInfo @PROJECT_VERSION@\nSource @ZZAPK_SOURCE_REVISION@\nQt @Qt6_VERSION@\nZzPureTools @ZZAPK_ZZPURETOOLS_REVISION@\n")
message(STATUS "Windows package: ${stage}")
